#include <iostream>
using namespace std;

int main()
{
    int a[] = {2, 0, 2, 1, 1, 0};
    int n = 6;

    int count0 = 0;
    int count1 = 0;
    int count2 = 0;

    // Count 0, 1 and 2
    for (int i = 0; i < n; i++)
    {
        if (a[i] == 0)
            count0++;
        else if (a[i] == 1)
            count1++;
        else
            count2++;
    }

    // Put 0s
    int index = 0;

    while (count0 > 0)
    {
        a[index] = 0;
        index++;
        count0--;
    }

    // Put 1s
    while (count1 > 0)
    {
        a[index] = 1;
        index++;
        count1--;
    }

    // Put 2s
    while (count2 > 0)
    {
        a[index] = 2;
        index++;
        count2--;
    }

    cout << "Sorted Colors: ";

    for (int i = 0; i < n; i++)
    {
        cout << a[i] << " ";
    }

    return 0;
}
