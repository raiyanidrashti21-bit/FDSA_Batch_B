#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

Node* front = NULL;

void display() {
    Node* temp = front;

    while (temp != NULL) {
        cout << temp->data << " ";
        temp = temp->next;
    }

    cout << endl;
}

void insertFront(int value) {
    Node* newNode = new Node();

    newNode->data = value;
    newNode->next = front;
    front = newNode;

    display();
}

void insertRear(int value) {
    Node* newNode = new Node();

    newNode->data = value;
    newNode->next = NULL;

    if (front == NULL) {
        front = newNode;
    } else {
        Node* temp = front;

        while (temp->next != NULL) {
            temp = temp->next;
        }

        temp->next = newNode;
    }

    display();
}

void insertAtPosition(int value, int position) {
    if (position == 1) {
        insertFront(value);
        return;
    }

    Node* temp = front;

    for (int i = 1; i < position - 1 && temp != NULL; i++) {
        temp = temp->next;
    }

    if (temp == NULL) {
        cout << "Invalid position" << endl;
        return;
    }

    Node* newNode = new Node();

    newNode->data = value;
    newNode->next = temp->next;
    temp->next = newNode;

    display();
}

int main() {
    insertRear(10);
    insertRear(20);
    insertFront(5);
    insertAtPosition(15, 3);
    insertAtPosition(25, 5);
    insertAtPosition(30, 10);

    return 0;
}

#include <iostream>
#include <algorithm>
using namespace std;

// Linear Search
int linearSearch(int arr[], int n, int key, int &comparisons)
{
    comparisons = 0;

    for (int i = 0; i < n; i++)
    {
        comparisons++;

        if (arr[i] == key)
            return i;
    }

    return -1;
}

// Binary Search
int binarySearch(int arr[], int n, int key, int &comparisons)
{
    comparisons = 0;

    int low = 0;
    int high = n - 1;

    while (low <= high)
    {
        int mid = low + (high - low) / 2;

        comparisons++;

        if (arr[mid] == key)
            return mid;

        comparisons++;

        if (key < arr[mid])
            high = mid - 1;
        else
            low = mid + 1;
    }

    return -1;
}

int main()
{
    int N;

    cout << "Enter number of badge IDs: ";
    cin >> N;

    // Handle empty input
    if (N <= 0)
    {
        cout << "\nNo badge IDs entered.\n";
        cout << "No repeated badge IDs.\n";

        int Q;
        cout << "\nEnter number of verification requests: ";
        cin >> Q;

        for (int i = 0; i < Q; i++)
        {
            int key;
            cout << "\nEnter badge ID to verify: ";
            cin >> key;

            cout << "Badge ID: " << key << endl;
            cout << "Found / Not Found: Not Found" << endl;
            cout << "First position in original record: -1" << endl;
            cout << "Number of comparisons - Method 1: 0" << endl;
            cout << "Number of comparisons - Method 2: 0" << endl;
        }

        cout << "\nTotal comparisons - Method 1: 0" << endl;
        cout << "Total comparisons - Method 2: 0" << endl;
        cout << "Better method: Both methods (no comparisons were required)." << endl;

        return 0;
    }

    int *badge = new int[N];
    int *sortedBadge = new int[N];

    // 1. Read badge IDs and preserve original order
    cout << "\nEnter " << N << " badge IDs:\n";

    for (int i = 0; i < N; i++)
    {
        cin >> badge[i];
        sortedBadge[i] = badge[i];
    }

    // 2. Display repeated badge IDs
    cout << "\n--- Repeated Badge IDs ---\n";

    bool foundRepeated = false;

    for (int i = 0; i < N; i++)
    {
        // Check whether this ID appeared earlier
        bool alreadyReported = false;

        for (int j = 0; j < i; j++)
        {
            if (badge[j] == badge[i])
            {
                alreadyReported = true;
                break;
            }
        }

        if (alreadyReported)
            continue;

        // Count occurrences
        int count = 0;

        for (int j = 0; j < N; j++)
        {
            if (badge[j] == badge[i])
                count++;
        }

        if (count > 1)
        {
            cout << "Badge ID: " << badge[i]
                 << " | Occurrences: " << count << endl;

            foundRepeated = true;
        }
    }

    if (!foundRepeated)
        cout << "No repeated badge IDs.\n";

    // 3. Sort the second copy
    sort(sortedBadge, sortedBadge + N);

    cout << "\n--- Sorted Badge IDs ---\n";

    for (int i = 0; i < N; i++)
        cout << sortedBadge[i] << " ";

    cout << endl;

    // 4. Read Q queries
    int Q;

    cout << "\nEnter number of verification requests: ";
    cin >> Q;

    int totalLinearComparisons = 0;
    int totalBinaryComparisons = 0;

    // 5 & 6. Process every query
    for (int q = 0; q < Q; q++)
    {
        int key;

        cout << "\nEnter badge ID to verify: ";
        cin >> key;

        int linearComparisons;
        int binaryComparisons;

        int linearPosition =
            linearSearch(badge, N, key, linearComparisons);

        int binaryPosition =
            binarySearch(sortedBadge, N, key, binaryComparisons);

        totalLinearComparisons += linearComparisons;
        totalBinaryComparisons += binaryComparisons;

        cout << "\nBadge ID: " << key;

        if (linearPosition != -1)
        {
            cout << "\nFound / Not Found: Found";
            cout << "\nFirst position in original record: "
                 << linearPosition + 1;
        }
        else
        {
            cout << "\nFound / Not Found: Not Found";
            cout << "\nFirst position in original record: -1";
        }

        cout << "\nNumber of comparisons - Method 1: "
             << linearComparisons;

        cout << "\nNumber of comparisons - Method 2: "
             << binaryComparisons;

        cout << "\n";
    }

    // 7. Total comparisons and better method
    cout << "\n========== FINAL RESULT ==========\n";

    cout << "Total comparisons - Method 1 (Linear Search): "
         << totalLinearComparisons << endl;

    cout << "Total comparisons - Method 2 (Binary Search): "
         << totalBinaryComparisons << endl;

    if (totalLinearComparisons < totalBinaryComparisons)
    {
        cout << "Better method: Method 1 (Linear Search)" << endl;
    }
    else if (totalBinaryComparisons < totalLinearComparisons)
    {
        cout << "Better method: Method 2 (Binary Search)" << endl;
    }
    else
    {
        cout << "Better method: Both methods performed equally." << endl;
    }

    delete[] badge;
    delete[] sortedBadge;

    return 0;
}
