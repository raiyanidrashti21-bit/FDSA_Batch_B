#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

Node* front = NULL;

void insert(int value) {
    Node* newNode = new Node();

    newNode->data = value;
    newNode->next = NULL;

    if (front == NULL) {
        front = newNode;
    } else {
        Node* temp = front;

        while (temp->next != NULL) {
            temp = temp->next;
        }

        temp->next = newNode;
    }
}

void deleteValue(int value) {
    Node* temp = front;
    Node* previous = NULL;

    while (temp != NULL && temp->data != value) {
        previous = temp;
        temp = temp->next;
    }

    if (temp == NULL) {
        cout << "Value not found" << endl;
        return;
    }

    if (previous == NULL) {
        front = temp->next;
    } else {
        previous->next = temp->next;
    }

    delete temp;
}

void forward() {
    Node* temp = front;

    while (temp != NULL) {
        cout << temp->data << " ";
        temp = temp->next;
    }

    cout << endl;
}

void reverse(Node* temp) {
    if (temp == NULL)
        return;

    reverse(temp->next);
    cout << temp->data << " ";
}

int main() {
    insert(10);
    insert(20);
    insert(30);
    insert(40);
    insert(50);

    cout << "Forward: ";
    forward();

    deleteValue(30);

    cout << "After deletion: ";
    forward();

    cout << "Reverse: ";
    reverse(front);

    return 0;
}
