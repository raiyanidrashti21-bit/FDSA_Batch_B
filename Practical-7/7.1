#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter queue size: ";
    cin >> n;

    int queue[100];
    int front = -1, rear = -1;

    int choice, value;

    while (true) {
        cout << "\n1. Join\n2. Serve\n3. Display Front\n4. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        if (choice == 1) {
            cout << "Enter token: ";
            cin >> value;

            if (rear == n - 1) {
                cout << "Error: Queue is full\n";
            } else {
                if (front == -1)
                    front = 0;

                rear++;
                queue[rear] = value;

                cout << "Front token: " << queue[front] << endl;
            }
        }
        else if (choice == 2) {
            if (front == -1 || front > rear) {
                cout << "Error: Queue is empty\n";
            } else {
                front++;

                if (front > rear) {
                    front = -1;
                    rear = -1;
                    cout << "Queue is empty\n";
                } else {
                    cout << "Front token: " << queue[front] << endl;
                }
            }
        }
        else if (choice == 3) {
            if (front == -1 || front > rear)
                cout << "Queue is empty\n";
            else
                cout << "Front token: " << queue[front] << endl;
        }
        else if (choice == 4) {
            break;
        }
        else {
            cout << "Invalid choice\n";
        }
    }

    return 0;
}
